{
  "name": "@gavinc-cn/dsh-superpowers-priming",
  "title": "Superpowers 开场注入",
  "description": "DSH 原生插件：会话重开（agent/created source=resume）时，若会话历史里没有 superpowers 开场说明（桥接 hooks-claude-code 或本插件注入过），补注入一次 using-superpowers 全文；已有则跳过，避免重复占用上下文。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinc-cn/dsh-plugins.git",
    "directory": "packages/runtime/dsh-superpowers-priming"
  },
  "homepage": "https://github.com/gavinc-cn/dsh-plugins/tree/master/packages/runtime/dsh-superpowers-priming#readme",
  "bugs": "https://github.com/gavinc-cn/dsh-plugins/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}

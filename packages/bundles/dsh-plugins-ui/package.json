{
  "name": "@gavinc-cn/dsh-plugins-ui",
  "version": "0.1.5",
  "description": "DSH 插件组合包（UI bundle）：8 个面向 Web GUI 的组件（dsh-feishu 提供飞书桥接与侧栏面板，dsh-session-live-metrics 提供状态栏近 1 分钟速度与费用，dsh-patch-ask-expand 由宿主侧启动时给官方 client bundle 打补丁实现），每个是一行独立开关；其余宿主侧组件见 @gavinc-cn/dsh-plugins-runtime。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinc-cn/dsh-plugins.git",
    "directory": "packages/bundles/dsh-plugins-ui"
  },
  "homepage": "https://github.com/gavinc-cn/dsh-plugins/tree/master/packages/bundles/dsh-plugins-ui#readme",
  "bugs": "https://github.com/gavinc-cn/dsh-plugins/issues",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "ui"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@gavinc-cn/dsh-dim-text": "^0.2.0",
    "@gavinc-cn/dsh-feishu": "^0.1.0",
    "@gavinc-cn/dsh-patch-ask-expand": "^0.1.1",
    "@gavinc-cn/dsh-prompt-recall": "^0.1.0",
    "@gavinc-cn/dsh-session-live-metrics": "^0.1.0",
    "@gavinc-cn/dsh-session-unread-persist": "^0.1.1",
    "@gavinc-cn/dsh-turn-labels": "^0.6.1",
    "@gavinc-cn/dsh-sidebar-width-persist": "^0.1.0"
  }
}

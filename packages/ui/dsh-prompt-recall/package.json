{
  "name": "@gavinc-cn/dsh-prompt-recall",
  "description": "在 DSH Web GUI 当前会话的输入框为空时，按方向上键召回上一条真人提问的完整文本，再按方向下键恢复原草稿；只恢复草稿，不自动发送。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.bundle.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/prompt-recall.spec.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinc-cn/dsh-plugins.git",
    "directory": "packages/ui/dsh-prompt-recall"
  },
  "homepage": "https://github.com/gavinc-cn/dsh-plugins/tree/master/packages/ui/dsh-prompt-recall#readme",
  "bugs": "https://github.com/gavinc-cn/dsh-plugins/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
